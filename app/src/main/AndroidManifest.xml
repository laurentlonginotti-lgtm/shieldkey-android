<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AUCUNE permission réseau : le coffre est 100 % hors-ligne.
         C'est volontaire (argument de confiance + 0 surface de fuite). -->

    <!-- Biométrie : accès au capteur d'empreinte / visage. Permission LOCALE au matériel,
         ce n'est PAS une permission Internet — l'argument "100 % hors-ligne" reste vrai. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Superpositions : permet à ShieldKey d'interdire aux autres applis de dessiner par-dessus
         elle (Android 12+). Permission « normale » (accordée à l'installation, sans demande),
         locale à l'affichage — là encore, rien de réseau. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Détection de root (avertissement, jamais un blocage) : depuis Android 11, une appli ne
         « voit » un autre paquet que si elle le déclare ici. Uniquement les gestionnaires de root
         connus — pas QUERY_ALL_PACKAGES, qui serait une vraie intrusion. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="me.phh.superuser" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShieldKey">

        <!-- taskAffinity="" : sur Android 8 à 10, une appli malveillante pouvait déclarer
             l'affinité de tâche de ShieldKey et se glisser DANS sa tâche — l'utilisateur ouvre
             ShieldKey et voit un faux écran de déverrouillage dessiné par l'autre appli
             (StrandHogg, corrigé par Android 11). Une affinité vide ferme cette porte. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage TEMPORAIRE d'un document déchiffré vers une visionneuse externe.
             exported=false + autorisation d'URI ponctuelle : seule l'appli choisie y accède,
             le temps de la lecture (le fichier en clair est effacé au retour / au verrouillage). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
