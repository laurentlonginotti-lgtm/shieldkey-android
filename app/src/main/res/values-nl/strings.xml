    <!-- Security page -->
    <string name="sec_open">🛡️ Beveiliging</string>
    <string name="sec_title">Beveiliging</string>
    <string name="sec_tagline">Jouw vertrouwen, uitgelegd.</string>
    <string name="sec_intro">ShieldKey is zo gebouwd dat je gegevens van jou blijven. Zo werkt het, zonder jargon.</string>
    <string name="sec_offline_title" formatted="false">🌐 100% offline</string>
    <string name="sec_offline_body">Geen internetmachtiging. Niets verlaat ooit je telefoon. Geen account, geen server: niets om op afstand te hacken.</string>
    <string name="sec_offline_tech">0 netwerkmachtigingen · cloudback-up uitgeschakeld</string>
    <string name="sec_aes_title">🔐 AES-256-GCM-versleuteling</string>
    <string name="sec_aes_body">Militair niveau en geauthenticeerd: als er één byte is gewijzigd of de sleutel klopt niet, mislukt het openen gewoon.</string>
    <string name="sec_aes_tech">AES-256 · GCM · 128-bits tag · willekeurige IV per item</string>
    <string name="sec_argon_title">🧗 Argon2id-sleutelafleiding</string>
    <string name="sec_argon_body">Je hoofdwachtwoord wordt door Argon2id omgezet in een sleutel — \"memory-hard\", ontworpen om grootschalig kraken traag en duur te maken (anti-GPU/ASIC), veel robuuster dan PBKDF2.</string>
    <string name="sec_argon_tech">Argon2id · %1$d rondes · %2$d MB · parallellisme %3$d</string>
    <string name="sec_envelope_title">🕵️ Zero-knowledge</string>
    <string name="sec_envelope_body">Je hoofdwachtwoord wordt nergens opgeslagen. Het ontgrendelt alleen een interne willekeurige sleutel. Niemand, zelfs de ontwikkelaar niet, kan je kluis openen zonder je wachtwoord.</string>
    <string name="sec_envelope_tech">Envelope-versleuteling · willekeurige 256-bits sleutel</string>
    <string name="sec_recovery_title">🔑 Herstelkit, geen achterdeur</string>
    <string name="sec_recovery_body">Als je je hoofdwachtwoord vergeet, kan alleen JOUW herstelcode (die je hebt opgeschreven) de kluis herstellen. Geen e-mail, geen herstelserver: geen achterdeur.</string>
    <string name="sec_bio_title">👆 Snel ontgrendelen met hardwarebeveiliging</string>
    <string name="sec_bio_body">Vingerafdruk of schermcode: de ontgrendelsleutel zit in de beveiligde chip van je telefoon en verlaat die nooit. Je hoofdwachtwoord blijft de echte bescherming.</string>
    <string name="sec_bio_tech">Android Keystore / TEE / StrongBox</string>
    <string name="sec_clip_title">📋 Beveiligd klembord</string>
    <string name="sec_clip_body">Wanneer je een geheim kopieert, wordt het gemarkeerd als \"gevoelig\" (verborgen in de klembordgeschiedenis) en automatisch gewist.</string>
    <string name="sec_docs_title">📄 Versleutelde offline documenten</string>
    <string name="sec_docs_body">Elk document wordt apart versleuteld en blijft bruikbaar, ook zonder verbinding.</string>
    <string name="sec_phish_title">🎣 We vragen nooit om je gegevens</string>
    <string name="sec_phish_body">ShieldKey zal je nooit e-mailen of sms\'en om je wachtwoord of gegevens te vragen. Doet iemand dat wel, dan zijn wij het niet.</string>
    <string name="sec_footer">AES-256-GCM · Argon2id · 0 internet</string>

