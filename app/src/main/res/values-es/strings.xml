    <!-- Security page -->
    <string name="sec_open">🛡️ Seguridad</string>
    <string name="sec_title">Seguridad</string>
    <string name="sec_tagline">Tu confianza, explicada.</string>
    <string name="sec_intro">ShieldKey está diseñada para que tus datos sigan siendo tuyos. Así funciona, sin jerga.</string>
    <string name="sec_offline_title">🌐 100%% sin conexión</string>
    <string name="sec_offline_body">Sin permiso de Internet. Nada sale nunca de tu teléfono. Sin cuenta, sin servidor: nada que hackear a distancia.</string>
    <string name="sec_offline_tech">0 permisos de red · copia en la nube desactivada</string>
    <string name="sec_aes_title">🔐 Cifrado AES-256-GCM</string>
    <string name="sec_aes_body">De grado militar y autenticado: si se altera un solo byte o la clave es incorrecta, la apertura simplemente falla.</string>
    <string name="sec_aes_tech">AES-256 · GCM · etiqueta de 128 bits · IV aleatorio por elemento</string>
    <string name="sec_argon_title">🧗 Derivación de clave Argon2id</string>
    <string name="sec_argon_body">Tu contraseña maestra se convierte en clave mediante Argon2id, \"memory-hard\", diseñado para que descifrarla a gran escala sea lento y costoso (anti-GPU/ASIC), mucho más robusto que PBKDF2.</string>
    <string name="sec_argon_tech">Argon2id · %1$d pasadas · %2$d MB · paralelismo %3$d</string>
    <string name="sec_envelope_title">🕵️ Conocimiento cero</string>
    <string name="sec_envelope_body">Tu contraseña maestra no se guarda en ningún sitio. Solo desbloquea una clave interna aleatoria. Nadie, ni siquiera el desarrollador, puede abrir tu caja fuerte sin tu contraseña.</string>
    <string name="sec_envelope_tech">Cifrado de sobre · clave aleatoria de 256 bits</string>
    <string name="sec_recovery_title">🔑 Kit de recuperación, sin puerta trasera</string>
    <string name="sec_recovery_body">Si olvidas tu contraseña maestra, solo TU código de recuperación (el que anotaste) puede restaurar la caja fuerte. Sin correo, sin servidor de recuperación: sin puerta trasera.</string>
    <string name="sec_bio_title">👆 Desbloqueo rápido respaldado por hardware</string>
    <string name="sec_bio_body">Huella o código de pantalla: la clave de desbloqueo vive en el chip seguro de tu teléfono y nunca sale de él. Tu contraseña maestra sigue siendo la verdadera protección.</string>
    <string name="sec_bio_tech">Android Keystore / TEE / StrongBox</string>
    <string name="sec_clip_title">📋 Portapapeles reforzado</string>
    <string name="sec_clip_body">Cuando copias un secreto, se marca como \"sensible\" (oculto del historial del portapapeles) y se borra automáticamente.</string>
    <string name="sec_docs_title">📄 Documentos cifrados sin conexión</string>
    <string name="sec_docs_body">Cada documento se cifra por separado y sigue siendo utilizable incluso sin red.</string>
    <string name="sec_phish_title">🎣 Nunca te pediremos tus datos</string>
    <string name="sec_phish_body">ShieldKey nunca te enviará un correo o SMS para pedirte tu contraseña o tus datos. Si alguien lo hace, no somos nosotros.</string>
    <string name="sec_footer">AES-256-GCM · Argon2id · 0 Internet</string>

