    <!-- Security page -->
    <string name="sec_open">🛡️ Bezpieczeństwo</string>
    <string name="sec_title">Bezpieczeństwo</string>
    <string name="sec_tagline">Twoje zaufanie, wyjaśnione.</string>
    <string name="sec_intro">ShieldKey jest zbudowany tak, aby Twoje dane pozostały Twoje. Oto jak — bez żargonu.</string>
    <string name="sec_offline_title">🌐 100%% offline</string>
    <string name="sec_offline_body">Brak uprawnienia do Internetu. Nic nigdy nie opuszcza Twojego telefonu. Bez konta, bez serwera — nie ma czego zhakować zdalnie.</string>
    <string name="sec_offline_tech">0 uprawnień sieciowych · kopia w chmurze wyłączona</string>
    <string name="sec_aes_title">🔐 Szyfrowanie AES-256-GCM</string>
    <string name="sec_aes_body">Klasy wojskowej i uwierzytelnione: jeśli zmieni się choć jeden bajt lub klucz jest błędny, otwarcie po prostu się nie powiedzie.</string>
    <string name="sec_aes_tech">AES-256 · GCM · tag 128-bitowy · losowy IV dla każdego elementu</string>
    <string name="sec_argon_title">🧗 Wyprowadzanie klucza Argon2id</string>
    <string name="sec_argon_body">Twoje hasło główne jest zamieniane w klucz przez Argon2id — \"memory-hard\", zaprojektowany tak, aby łamanie na masową skalę było wolne i kosztowne (anty-GPU/ASIC), znacznie odporniejszy niż PBKDF2.</string>
    <string name="sec_argon_tech">Argon2id · %1$d przebiegi · %2$d MB · równoległość %3$d</string>
    <string name="sec_envelope_title">🕵️ Zero-knowledge</string>
    <string name="sec_envelope_body">Twoje hasło główne nie jest nigdzie zapisywane. Odblokowuje jedynie wewnętrzny losowy klucz. Nikt — nawet twórca aplikacji — nie otworzy Twojego sejfu bez Twojego hasła.</string>
    <string name="sec_envelope_tech">Szyfrowanie kopertowe · losowy klucz 256-bitowy</string>
    <string name="sec_recovery_title">🔑 Zestaw odzyskiwania, bez tylnych drzwi</string>
    <string name="sec_recovery_body">Jeśli zapomnisz hasła głównego, tylko TWÓJ kod odzyskiwania (ten, który zapisałeś) może przywrócić sejf. Bez e-maila, bez serwera odzyskiwania — bez tylnych drzwi.</string>
    <string name="sec_bio_title">👆 Szybkie odblokowanie chronione sprzętowo</string>
    <string name="sec_bio_body">Odcisk palca lub kod ekranu: klucz odblokowujący znajduje się w bezpiecznym układzie telefonu i nigdy go nie opuszcza. Hasło główne pozostaje prawdziwym zabezpieczeniem.</string>
    <string name="sec_bio_tech">Android Keystore / TEE / StrongBox</string>
    <string name="sec_clip_title">📋 Wzmocniony schowek</string>
    <string name="sec_clip_body">Gdy kopiujesz sekret, jest oznaczany jako \"poufny\" (ukryty w historii schowka) i automatycznie usuwany.</string>
    <string name="sec_docs_title">📄 Zaszyfrowane dokumenty offline</string>
    <string name="sec_docs_body">Każdy dokument jest szyfrowany osobno i pozostaje dostępny nawet bez połączenia.</string>
    <string name="sec_phish_title">🎣 Nigdy nie poprosimy o Twoje dane</string>
    <string name="sec_phish_body">ShieldKey nigdy nie wyśle Ci e-maila ani SMS-a z prośbą o hasło lub dane. Jeśli ktoś to zrobi, to nie my.</string>
    <string name="sec_footer">AES-256-GCM · Argon2id · 0 Internetu</string>

